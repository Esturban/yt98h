# Copy to .env and fill in for this poll. .env is gitignored, never committed.
# This is the entire per-poll configuration surface, nothing else needs editing.

# Unique per poll across the fleet, e.g. poll-01, poll-02, ... poll-08.
SITE_ID=poll-01

# Command center.
INFLUXDB_URL=http://command-center:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=

# Client's live production ingest API. Optional: leave IR4_DEVICE_TOKEN blank
# to keep this poll InfluxDB only, identical to before this path existed.
IR4_INGEST_URL=https://ir4.ispc-ai.com/api/ingest/gas-readings
IR4_DEVICE_TOKEN=
